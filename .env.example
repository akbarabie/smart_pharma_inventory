# ============================================================
# Salin file ini menjadi ".env" lalu isi nilainya masing-masing.
# File ".env" JANGAN PERNAH di-commit ke git (sudah ada di .gitignore).
# ============================================================

# --- ID user, supaya file yang dibuat Airflow di dalam container tidak
#     jadi milik root di sistem file host kamu (khusus Linux/WSL, di Mac boleh diisi 50000) ---
AIRFLOW_UID=50000

# --- Database internal Airflow (lokal, di dalam docker compose ini saja) ---
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=airflow
POSTGRES_AIRFLOW_DB=airflow

# Generate dengan perintah ini di terminal (butuh python + package cryptography):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- MinIO (bronze layer object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# --- Postgres GOLD/SILVER hosted (Neon/Supabase) ---
# INI YANG DIPAKAI BERSAMA oleh DE, DS, dan DA. Bagikan nilai ini ke tim,
# jangan bagikan lewat chat publik, pakai channel privat tim.
# Format: postgresql://user:password@host/namadatabase
GOLD_DATABASE_URL=

# --- Claude API, dipakai AI Agent Layer (baru dipakai mulai hari ke-5) ---
ANTHROPIC_API_KEY=
